# Copy this file to .env and fill in the values. Never commit .env.

# TheMovieDB API key (movies and TV metadata).
# Create a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Contact string sent in the User-Agent of MusicBrainz requests, as required by
# their rate-limiting rules. Example: CopyCast/0.1 (you@example.com)
MUSICBRAINZ_USER_AGENT=
